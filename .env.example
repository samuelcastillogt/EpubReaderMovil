# Copia este archivo a .env.local y completa las claves. Todas son opcionales.
# Analytics y errores (PostHog: https://posthog.com, clave "Project API key")
EXPO_PUBLIC_POSTHOG_KEY= 
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase (respaldo, lista de espera y resumenes IA)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (claves publicas de SDK)
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_IOS_KEY=

# Pruebas internas: 1 = desbloquea Pro sin compra. Nunca en produccion.
EXPO_PUBLIC_FORCE_PRO=
